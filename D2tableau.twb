      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1849151522549760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Review Scores Rating]*[Number Of Reviews]' />
      </column>
      <column caption='Total Price' datatype='integer' name='[Calculation_1849151523569665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Price])' />
      </column>
      <column caption='Pricing Category' datatype='string' name='[Calculation_1849151525388290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;STANDARD&quot;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;END' />
      </column>
      <column caption='Number of Reviews' datatype='string' name='[Calculation_1849151528267779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly Review&quot;&#13;&#10;ELSE &quot;Less Review&quot;&#13;&#10;END' />
      </column>
      <column caption='Host status' datatype='string' name='[Calculation_1849151529467908]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1849151536029704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1849151533576199]THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
